+    def _get_audio_metadata_lengths(
+        self, audios: list["AudioInput"], processor: "MMProcessor"
+    ) -> list[int]:
+        r"""Derive Omni audio-token lengths without calculating log-Mel features."""
+        feature_extractor: SequenceFeatureExtractor = getattr(processor, "feature_extractor", None)
+        target_rate: int = getattr(processor, "audio_sampling_rate", 16000)
+        hop_length: int = getattr(feature_extractor, "hop_length", 160)
+        max_samples: int = getattr(feature_extractor, "n_samples", 4800000)
+        lengths = []
+        for audio in audios:
+            if isinstance(audio, np.ndarray):
+                sample_count = int(audio.shape[-1])
+            elif isinstance(audio, (str, os.PathLike)):
+                import soundfile as sf
+
+                info = sf.info(audio)
+                # librosa.resample(..., fix=True) pads/trims to ceil(target length).
+                sample_count = math.ceil(info.frames * target_rate / info.samplerate)
+            else:
+                # File-like inputs do not have a stable metadata contract, so retain
+                # the exact original preprocessing as a conservative fallback.
+                regularized = self._regularize_audios([audio], sampling_rate=target_rate)["audios"]
+                sample_count = int(regularized[0].shape[-1])
+
+            sample_count = min(sample_count, max_samples)
+            feature_mask_length = math.ceil(sample_count / hop_length)
+            input_length = (feature_mask_length - 1) // 2 + 1
+            lengths.append((input_length - 2) // 2 + 1)
+
+        return lengths
+
+    def _get_video_metadata_inputs(
+        self, videos: list["VideoInput"], processor: "MMProcessor"
+    ) -> dict[str, "torch.Tensor"]:
+        r"""Compute Qwen video token grids without decoding video frames.
+
+        ``process_messages`` only needs the spatial/temporal grid to expand the
+        video placeholder.  Decoding pixels at that stage is redundant because
+        the multimodal collator decodes them again immediately before the model
+        forward.  This opt-in path derives the exact grid from container metadata
+        and falls back to the regular processor for non-file video inputs.
+        """
+        image_processor: BaseImageProcessor = getattr(processor, "image_processor", None)
+        patch_size: int = getattr(image_processor, "patch_size", 14)
+        temporal_patch_size: int = getattr(image_processor, "temporal_patch_size", 2)
+        merge_size: int = getattr(image_processor, "merge_size", 2)
+        processor_size = getattr(image_processor, "size", {})
+        min_pixels: int = processor_size.get("shortest_edge", 56 * 56)
+        max_pixels: int = processor_size.get("longest_edge", 14 * 14 * 4 * 1280)
+        regularize_max: int = getattr(processor, "video_max_pixels", 256 * 256)
+        regularize_min: int = getattr(processor, "video_min_pixels", 16 * 16)
+        video_fps: float = getattr(processor, "video_fps", 2.0)
+        video_maxlen: int = getattr(processor, "video_maxlen", 128)
+
+        # Keep the resizing calculation in one place with Transformers, whose
+        # Qwen implementation defines the token-grid rounding contract.
+        from transformers.models.qwen2_vl.image_processing_qwen2_vl import smart_resize
+
+        grids, seconds_per_grid = [], []
+        for video in videos:
+            if _check_video_is_nested_images(video) or not isinstance(video, (str, os.PathLike)):
+                fallback = self._get_mm_inputs([], [video], [], processor)
+                grids.append(fallback["video_grid_thw"][0])
+                seconds_per_grid.append(fallback["video_second_per_grid"][0])
+                continue
+
+            container = av.open(video, "r")
+            try:
+                video_stream = next(stream for stream in container.streams if stream.type == "video")
+                sample_indices = self._get_video_sample_indices(
+                    video_stream, video_fps=video_fps, video_maxlen=video_maxlen
+                )
+                frame_count = len(sample_indices)
+                if frame_count % 2 != 0:
+                    frame_count += 1
+
+                width, height = int(video_stream.width), int(video_stream.height)
+                area = width * height
+                if area > regularize_max:
+                    scale = math.sqrt(regularize_max / area)
+                    width, height = int(width * scale), int(height * scale)
+                elif area < regularize_min:
+                    scale = math.sqrt(regularize_min / area)
+                    width, height = int(width * scale), int(height * scale)
+
+                width, height = max(width, 28), max(height, 28)
+                if width / height > 200:
+                    width = height * 180
+                elif height / width > 200:
+                    height = width * 180
+
+                resized_height, resized_width = smart_resize(
+                    height,
+                    width,
+                    factor=patch_size * merge_size,
+                    min_pixels=min_pixels,
+                    max_pixels=max_pixels,
+                )
+                grids.append(
+                    torch.tensor(
+                        [
+                            frame_count // temporal_patch_size,
+                            resized_height // patch_size,
+                            resized_width // patch_size,
+                        ],
+                        dtype=torch.long,
+                    )
+                )
+                duration = (
+                    float(video_stream.duration * video_stream.time_base)
+                    if video_stream.duration is not None
+                    else None
+                )
+                sampled_fps = frame_count / duration if duration else video_fps
+                seconds_per_grid.append(torch.tensor(temporal_patch_size / sampled_fps))
+            finally:
+                container.close()
+
+        return {
+            "video_grid_thw": torch.stack(grids) if grids else torch.empty((0, 3), dtype=torch.long),
+            "video_second_per_grid": torch.stack(seconds_per_grid) if seconds_per_grid else torch.empty(0),
+        }
+
