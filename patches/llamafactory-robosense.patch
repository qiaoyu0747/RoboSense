+@dataclass
+class MultimodalAuxiliarySFTDataCollatorWith4DAttentionMask(SFTDataCollatorWith4DAttentionMask):
+    r"""Batch auxiliary detection and KD metadata without requiring a sensor field."""
+
+    def __call__(self, features: list[dict[str, Any]]) -> dict[str, "torch.Tensor"]:
+        metadata = {
+            "anomaly_labels": ([feature.pop("anomaly", None) for feature in features], torch.float32),
+            "teacher_scores": ([feature.pop("teacher_score", None) for feature in features], torch.float32),
+            "task_labels": ([feature.pop("task_label", None) for feature in features], torch.long),
+            "action_labels": ([feature.pop("action_label", None) for feature in features], torch.long),
+            "object_labels": ([feature.pop("object_label", None) for feature in features], torch.long),
+            "active_task_masks": ([feature.pop("active_task_mask", None) for feature in features], torch.bool),
+            "previous_edge_scores": ([feature.pop("previous_edge_score", None) for feature in features], torch.float32),
+            "teacher_embeddings": ([feature.pop("teacher_embedding", None) for feature in features], torch.float32),
+            "teacher_quality_weights": ([feature.pop("teacher_quality_weight", None) for feature in features], torch.float32),
+            "disagreement_labels": ([feature.pop("disagreement_label", None) for feature in features], torch.float32),
+            "replay_labels": ([feature.pop("replay_label", None) for feature in features], torch.float32),
+        }
+        if any("sensor" in feature and feature["sensor"] is not None for feature in features):
+            raise ValueError("Sensorless multimodal auxiliary batches must not contain a `sensor` field.")
+        for feature in features:
+            feature.pop("sensor", None)
+        batch = super().__call__(features)
+        for name, (values, dtype) in metadata.items():
+            if all(value is not None for value in values):
+                batch[name] = torch.tensor(values, dtype=dtype)
+        return batch
+
